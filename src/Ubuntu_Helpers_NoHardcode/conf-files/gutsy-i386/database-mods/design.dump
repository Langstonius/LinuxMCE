--
-- Table structure for table `Screen_DesignObj`
--

DROP TABLE IF EXISTS `Screen_DesignObj`;
CREATE TABLE `Screen_DesignObj` (
  `PK_Screen_DesignObj` int(11) NOT NULL auto_increment,
  `FK_Screen` int(11) NOT NULL default '0',
  `FK_DesignObj` int(11) NOT NULL default '0',
  `FK_UI` int(11) default NULL,
  `FK_Skin` int(11) default NULL,
  `FK_DeviceTemplate` int(11) default NULL,
  `AsPopup` tinyint(1) NOT NULL default '0',
  `Popup_X` int(7) default NULL,
  `Popup_Y` int(7) default NULL,
  `psc_id` int(11) default NULL,
  `psc_batch` int(11) default NULL,
  `psc_user` int(11) default NULL,
  `psc_frozen` tinyint(1) default '0',
  `psc_mod` timestamp NULL default CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP,
  `psc_restrict` int(11) default NULL,
  PRIMARY KEY  (`PK_Screen_DesignObj`)
) ENGINE=InnoDB AUTO_INCREMENT=460 DEFAULT CHARSET=latin1;

