--
-- Table structure for table `DesignObjVariation`
--

DROP TABLE IF EXISTS `DesignObjVariation`;
CREATE TABLE `DesignObjVariation` (
  `PK_DesignObjVariation` int(11) NOT NULL auto_increment,
  `FK_DesignObj` int(11) NOT NULL default '0',
  `FK_UI` int(11) default NULL,
  `FK_DesignObj_Goto` int(11) default NULL,
  `FK_CommandGroup_D_OnActivate` int(11) default NULL,
  `FK_CommandGroup_D_OnLoad` int(11) default NULL,
  `FK_CommandGroup_D_OnUnload` int(11) default NULL,
  `FK_CommandGroup_D_OnTimeout` int(11) default NULL,
  `FK_CommandGroup_D_OnStartup` int(11) default NULL,
  `FK_CommandGroup_D_OnHighlight` int(11) default NULL,
  `FK_CommandGroup_D_OnUnhighlight` int(11) default NULL,
  `FK_EffectType_Selected_WithChange` int(11) default NULL,
  `FK_EffectType_Selected_NoChange` int(11) default NULL,
  `FK_EffectType_Highlighted` int(11) default NULL,
  `FK_Button` int(11) default NULL,
  `FK_Criteria_Orbiter` int(11) default NULL,
  `DontResetSelectedState` tinyint(4) NOT NULL default '0',
  `FK_StabilityStatus` int(11) NOT NULL default '1',
  `RepeatMS` int(11) NOT NULL default '0',
  `RepeatParm` tinyint(1) NOT NULL default '0',
  `PreserveTransparencies` tinyint(1) NOT NULL default '0',
  `psc_id` int(11) default NULL,
  `psc_batch` int(11) default NULL,
  `psc_user` int(11) default NULL,
  `psc_frozen` tinyint(1) default '0',
  `psc_mod` timestamp NULL default CURRENT_TIMESTAMP on update CURRENT_TIMESTAMP,
  `psc_restrict` int(11) default NULL,
  PRIMARY KEY  (`PK_DesignObjVariation`),
  UNIQUE KEY `psc_id` (`psc_id`)
) ENGINE=InnoDB AUTO_INCREMENT=8046 DEFAULT CHARSET=latin1;

